            "size": "lg"
          },
          {
            "id": "ex",
            "tex": "y=(x-1)^2+1\\ \\xrightarrow{\\;y\\text{축}\\;}\\ y=(\\p{s}{-x}-1)^2+1=(x+1)^2+1",
            "position": {
              "x": 0.5,
              "y": 0.78
            },
            "size": "md"
          }
        ],
        "initial": {
          "hidden_items": [
            "ex"
