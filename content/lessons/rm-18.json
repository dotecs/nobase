    {
      "id": "s3",
      "title": "대칭이동 정리",
      "tag": "derive",
      "headline": {
        "eyebrow": "18강 · 그래프의 대칭이동",
        "title": "뒤집히는 좌표의 부호를\n미리 바꿔 넣는다",
        "accent": "미리",
        "subtitle": "x축 대칭은 −y, y축 대칭은 −x",
        "accent_bar": true
      },
      "stage": {
        "type": "board",
        "items": [
          {
            "id": "a1",
            "text": "**$x$축 대칭** $y$ 대신 $-y$ 를 대입",
