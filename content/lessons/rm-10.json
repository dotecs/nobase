        "eyebrow": "10강 · 이차방정식의 해법",
        "title": "제곱근의 성질 이용",
        "accent": "제곱근",
        "subtitle": "(x+A)² = B 에서 괄호 안을 한 덩어리로 본다",
        "accent_bar": true
      },
      "stage": {
        "type": "table",
        "columns": [
