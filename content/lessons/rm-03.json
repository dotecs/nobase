    {
      "id": "s3",
      "title": "예시 — 나눗셈은 역수를 곱한다",
      "headline": {
        "eyebrow": "3강 · 분배 법칙",
        "title": "나눗셈은 역수의 곱",
        "accent": "역수",
        "subtitle": "(6x+12)÷(−3): ÷(−3)을 ×(−1/3)으로"
